  },
  {
    "id": 1778510976662,
    "admin": true,
    "text": "چی بگم پس صبر کن اعلان همگانی بزنه برا ورود به وصل هم باید اکانت بسازی کد 889",
    "time": "2026-05-11T14:49:36.662Z"
  },
  {
    "id": 1778511478484,
    "admin": false,
    "text": "ساختم",
    "time": "2026-05-11T14:57:58.484Z"
  },
  {
    "id": 1778511547613,
    "admin": false,
    "text": "رایگان میدی یعنی؟ کانفیننگ؟",
